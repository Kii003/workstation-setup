# local-ai - run models on your own machine (off by default: needs disk space and RAM)
# Good for private data that shouldn't leave the laptop, offline work, cheap bulk tasks.
# Apple Silicon with 16 GB+ RAM recommended; 32 GB+ for larger models.
brew "ollama"                  # CLI + local server:  ollama run <model>   (API on localhost:11434)
cask "lm-studio"               # desktop app: browse, download and chat with models (MLX on Apple Silicon)
