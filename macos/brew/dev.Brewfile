# dev — editors, GUIs and command-line helpers
cask "visual-studio-code"
cask "github"                  # GitHub Desktop
cask "tableplus"               # database GUI
# cask "cursor"
# cask "zed"

brew "jq"                      # read/filter JSON
brew "ripgrep"                 # fast code search (rg)
brew "fd"                      # fast file search
brew "fzf"                     # fuzzy finder, Ctrl+R history
brew "bat"                     # cat with syntax highlighting
brew "eza"                     # better ls
brew "zoxide"                  # jump to folders: z <name>
brew "direnv"                  # per-folder environment via .envrc
brew "tree"
brew "wget"
brew "httpie"                  # test HTTP APIs
brew "ffmpeg"
brew "imagemagick"
