# core — essentials every setup needs (keep this module enabled)
cask "1password"               # password manager — swap for "bitwarden" if you prefer
cask "1password-cli"           # `op`: inject secrets into .env files and scripts
brew "git"
brew "gh"                      # GitHub CLI: auth, clone, PRs
brew "mise"                    # per-project Node/Python/... versions (runtimes are set in config.sh)
